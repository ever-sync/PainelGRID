/// Jornada mensuravel de cada comunicacao disparada por workflow, agente ou operador.
/// O registro nasce antes/do envio e recebe os marcos do provedor e das conversoes.
model DispatchEvent {
  id                  String        @id @default(uuid()) @db.Uuid
  client_id           String        @db.Uuid
  event_id            String?       @db.Uuid
  lead_id             String        @db.Uuid
  conversation_id     String?       @db.Uuid
  message_id          String?       @db.Uuid
  appointment_id      String?       @db.Uuid
  sale_id             String?       @db.Uuid
  dispatch_key        String        @db.VarChar(191)
  workflow_key        String        @db.VarChar(160)
  dispatch_type       String        @db.VarChar(80)
  channel             String        @db.VarChar(40)
  provider            String?       @db.VarChar(80)
  provider_message_id String?       @db.VarChar(191)
  template_name       String?       @db.VarChar(512)
  status              String        @default("queued") @db.VarChar(40)
  scheduled_at        DateTime?
  sent_at             DateTime?
  delivered_at        DateTime?
  read_at             DateTime?
  replied_at          DateTime?
  failed_at           DateTime?
  converted_at        DateTime?
  conversion_type     String?       @db.VarChar(80)
  revenue             Decimal?      @db.Decimal(12, 2)
  failure_code        String?       @db.VarChar(100)
  failure_reason      String?
  metadata            Json          @default("{}")
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
  client              Client        @relation(fields: [client_id], references: [id], onDelete: Cascade)
  event               Event?        @relation(fields: [event_id], references: [id], onDelete: SetNull)
  lead                Lead          @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  conversation        Conversation? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)
  message             Message?      @relation(fields: [message_id], references: [id], onDelete: SetNull)
  appointment         Appointment?  @relation(fields: [appointment_id], references: [id], onDelete: SetNull)
  sale                Sale?         @relation(fields: [sale_id], references: [id], onDelete: SetNull)

  @@unique([client_id, dispatch_key])
  @@index([client_id, created_at(sort: Desc)])
  @@index([event_id, created_at(sort: Desc)])
  @@index([lead_id, created_at(sort: Desc)])
  @@index([workflow_key, status])
  @@index([provider_message_id])
  @@index([appointment_id])
  @@index([sale_id])
  @@map("dispatch_events")
}

model ScoreEvent {
  id             String         @id @default(uuid()) @db.Uuid
  client_id      String         @db.Uuid
  vendor_id      String         @db.Uuid
  lead_id        String         @db.Uuid
  appointment_id String?        @db.Uuid
  sale_id        String?        @db.Uuid
  kind           ScoreEventKind
  points         Int
  earned_at      DateTime       @default(now())
  created_at     DateTime       @default(now())
  appointment    Appointment?   @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  client         Client         @relation(fields: [client_id], references: [id], onDelete: Cascade)
  lead           Lead           @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  sale           Sale?          @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  vendor         User           @relation("VendorScoreEvents", fields: [vendor_id], references: [id])

  @@unique([appointment_id, kind])
  @@unique([client_id, vendor_id, lead_id, kind])
  @@index([client_id])
  @@index([vendor_id])
  @@index([lead_id])
  @@index([sale_id])
  @@index([earned_at])
  @@index([client_id, earned_at(sort: Desc)], map: "idx_score_events_client_earned_at")
  @@index([client_id, vendor_id, kind], map: "idx_score_events_client_vendor_kind")
  @@map("score_events")
}

model ConversationState {
  id                    String       @id @default(uuid()) @db.Uuid
  conversation_id       String       @unique @db.Uuid
  client_id             String       @db.Uuid
  lead_id               String       @db.Uuid
  current_intent        String?      @db.VarChar(120)
  awaiting_confirmation Boolean      @default(false)
  last_offered_event_id String?      @db.Uuid
  last_offered_slot     DateTime?
  last_agent_action     String?      @db.VarChar(120)
  handoff_required      Boolean      @default(false)
  handoff_reason        String?
  state_payload         Json         @default("{}")
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt
  client                Client       @relation(fields: [client_id], references: [id])
  conversation          Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  last_offered_event    Event?       @relation("ConversationStateLastOfferedEvent", fields: [last_offered_event_id], references: [id])
  lead                  Lead         @relation(fields: [lead_id], references: [id])

  @@index([client_id])
  @@index([lead_id])
  @@index([last_offered_event_id])
  @@index([updated_at])
  @@map("conversation_states")
}

model AgentActionLog {
  id               String       @id @default(uuid()) @db.Uuid
  client_id        String       @db.Uuid
  lead_id          String       @db.Uuid
  conversation_id  String       @db.Uuid
  provider         String?      @db.VarChar(80)
  model            String?      @db.VarChar(120)
  trigger_type     String       @db.VarChar(80)
  decision_type    String       @db.VarChar(80)
  confidence       Float?
  input_summary    String?
  output_summary   String?
  action_payload   Json         @default("{}")
  result_status    String       @db.VarChar(80)
  error_message    String?
  previous_state   Json?
  received_message String?
  next_stage       String?      @db.VarChar(120)
  tool_name        String?      @db.VarChar(120)
  tool_input       Json?
  api_response     Json?
  resulting_state  Json?
  block_reason     String?
  created_at       DateTime     @default(now())
  client           Client       @relation(fields: [client_id], references: [id])
  conversation     Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  lead             Lead         @relation(fields: [lead_id], references: [id])
  messages         Message[]

  @@index([client_id])
  @@index([lead_id])
  @@index([conversation_id, created_at])
  @@index([decision_type])
  @@index([result_status])
  @@index([created_at])
  @@map("agent_action_logs")
}

/// Fila operacional unificada. `fingerprint` evita criar várias ocorrências
/// para o mesmo problema enquanto occurrence_count/last_seen_at preservam a recorrência.
model OperationalIssue {
  id               String    @id @default(uuid()) @db.Uuid
  client_id        String?   @db.Uuid
  lead_id          String?   @db.Uuid
  conversation_id  String?   @db.Uuid
  event_id         String?   @db.Uuid
  type             String    @db.VarChar(80)
  severity         String    @default("warning") @db.VarChar(20)
  status           String    @default("open") @db.VarChar(20)
  title            String    @db.VarChar(255)
  message          String
  source           String    @db.VarChar(80)
  fingerprint      String    @unique @db.VarChar(255)
  metadata         Json      @default("{}")
  occurrence_count Int       @default(1)
  first_seen_at    DateTime  @default(now())
  last_seen_at     DateTime  @default(now())
  resolved_at      DateTime?
  resolved_by      String?   @db.Uuid
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([status, last_seen_at(sort: Desc)])
  @@index([type, status])
  @@index([client_id, status])
  @@index([lead_id])
  @@index([conversation_id])
  @@map("operational_issues")
}

model OperationalHeartbeat {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(120)
  client_id    String?  @db.Uuid
  status       String   @default("healthy") @db.VarChar(20)
  metadata     Json     @default("{}")
  last_seen_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([status, last_seen_at])
  @@index([client_id])
  @@map("operational_heartbeats")
}

model ApiIdempotencyRequest {
  id              String   @id @default(uuid()) @db.Uuid
  client_id       String   @db.Uuid
