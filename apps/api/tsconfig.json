{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@modules/*": ["src/modules/*"],
      "@common/*": ["src/common/*"],
      "@config/*": ["src/config/*"]
    }
  },
  "watchOptions": {
    "excludeDirectories": ["**/node_modules", "**/dist", "**/build", "**/coverage", "**/api/_nest"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "build", "test"]
}
