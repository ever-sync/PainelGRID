/// Regra operacional aplicada aos leads de um formulario Meta. Fica separada
/// da selecao de ativos porque essa selecao e recriada quando a BM e salva.
/// `form_id` e globalmente unico: o mesmo formulario nunca pode rotear leads
/// para dois clientes diferentes.
model MetaLeadRoutingRule {
  id                               String      @id @default(uuid()) @db.Uuid
  client_id                        String      @db.Uuid
