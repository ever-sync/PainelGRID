/// Vinculo explicito de uma campanha da Meta a um cliente e, opcionalmente,
/// a um evento. E a fonte de verdade de "de quem e esta campanha" quando
/// varios clientes dividem a mesma conta de anuncio.
///
/// `meta_campaign_id` e unico de proposito: uma campanha pertence a no maximo
/// um evento, entao o gasto dela nunca e contado em dois eventos diferentes.
/// Campanha sem `event_id` continua no cliente, so fora do calculo do evento.
model MetaCampaignAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  meta_campaign_id String   @unique @db.VarChar(100)
  /// Nome da campanha no momento do vinculo. Copia proposital: permite mostrar
  /// o vinculo sem depender de sync nem de ida a Graph API a cada render.
  campaign_name    String?  @db.VarChar(255)
  client_id        String   @db.Uuid
  event_id         String?  @db.Uuid
  /// Usuario que fez o vinculo. Sem relacao: e trilha de auditoria, e nao
  /// deve impedir a remocao de um usuario.
  assigned_by_id   String?  @db.Uuid
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  client           Client   @relation(fields: [client_id], references: [id])
  event            Event?   @relation(fields: [event_id], references: [id])

  @@index([client_id])
  @@index([event_id])
  @@map("meta_campaign_assignments")
}

