        "jsCode": "const canal = String($(\"Code in JavaScript2\").item.json.preferencia_atendimento ?? \"\")\n  .normalize(\"NFD\")\n  .replace(/[\\u0300-\\u036f]/g, \"\")\n  .trim()\n  .toLowerCase();\n\nlet stageCode;\nif (canal.includes(\"ligacao\") || canal.includes(\"telefone\")) {\n  stageCode = \"99640561BDB74BFB_LIGACAO\";\n} else if (canal.includes(\"whatsapp\")) {\n  stageCode = \"99640561BDB74BFB_TENTATIVA_CONTATO\";\n} else {\n  throw new Error(`Canal de atendimento invalido: ${canal || \"vazio\"}`);\n}\n\nreturn { ...$json, canal_normalizado: canal, stage_code_destino: stageCode };"
