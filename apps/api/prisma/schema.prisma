  whatsapp_stage_id                String      @db.Uuid
  whatsapp_template_name           String?     @db.VarChar(512)
  whatsapp_template_language       String?     @db.VarChar(20)
  whatsapp_template_parameter_keys String[]    @default([])
  created_at                       DateTime    @default(now())
  updated_at                       DateTime    @updatedAt
  client                           Client      @relation(fields: [client_id], references: [id], onDelete: Cascade)
  event                            Event       @relation(fields: [event_id], references: [id])
  crm_pipeline                     CrmPipeline @relation(fields: [crm_pipeline_id], references: [id])
  call_stage                       CrmStage    @relation("MetaLeadCallStage", fields: [call_stage_id], references: [id])
  whatsapp_stage                   CrmStage    @relation("MetaLeadWhatsappStage", fields: [whatsapp_stage_id], references: [id])

  @@index([client_id])
  @@index([event_id])
  @@index([crm_pipeline_id])
  @@index([call_stage_id])
  @@index([whatsapp_stage_id])
  @@map("meta_lead_routing_rules")
}

