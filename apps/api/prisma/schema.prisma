generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                           String             @id @default(uuid()) @db.Uuid
  name                         String             @db.VarChar(255)
  email                        String             @unique @db.VarChar(255)
  /// Nulo enquanto o vendedor auto-cadastrado nao criou a senha pelo link do e-mail.
  password_hash                String?            @db.VarChar(255)
  role                         Role
  avatar_url                   String?            @db.VarChar(500)
  phone                        String?            @db.VarChar(20)
  is_active                    Boolean            @default(true)
  created_at                   DateTime           @default(now())
  updated_at                   DateTime           @updatedAt
  client_id                    String?            @db.Uuid
  /// Token do gestor após OAuth Meta (uma conta para todos os clientes do gestor).
  meta_gestor_access_token     String?
  meta_gestor_token_expires_at DateTime?
  meta_gestor_scopes           String[]           @default([])
  meta_gestor_connected_at     DateTime?
  vendor_category              VendorCategory?
  vendor_categories            VendorCategory[]   @default([])
  auth_provider_id             String?            @unique @db.VarChar(255)
  /// Token do link publico de avaliacao de atendimento (somente vendedores).
  rating_token                 String?            @unique @db.VarChar(64)
  /// Estado do auto-cadastro publico. `approved` para todo usuario criado pelo painel.
  /// Nao substitui `is_active`: quem esta pendente tem is_active=false, mas o inverso
  /// nao vale (desativado manualmente continua approved).
  approval_status              UserApprovalStatus @default(approved)
  approved_at                  DateTime?
  approved_by_id               String?            @db.Uuid
  approved_by                  User?              @relation("UserApprovals", fields: [approved_by_id], references: [id], onDelete: SetNull)
  approvals_made               User[]             @relation("UserApprovals")
  campaign_vendors             CampaignVendor[]
  managed_clients              Client[]           @relation("GestorClients")
  course_progress              CourseProgress[]
  crm_changes                  CrmHistory[]
  assigned_leads               Lead[]             @relation("VendorLeads")
  attended_leads               Lead[]             @relation("LeadAttendantUser")
  registered_leads             Lead[]             @relation("LeadRegisteredBy")
  sold_leads                   Lead[]             @relation("LeadSoldByVendor")
  sales                        Sale[]             @relation("VendorSales")
  sales_team_memberships       SalesTeamMember[]
  score_events                 ScoreEvent[]       @relation("VendorScoreEvents")
  service_ratings              ServiceRating[]
  client                       Client?            @relation("ClientStaff", fields: [client_id], references: [id])
  notifications                Notification[]
  vendor_availability          VendorAvailability?
  vendor_attendances           VendorAttendance[] @relation("VendorAttendanceVendor")
  vendor_attendances_created   VendorAttendance[] @relation("VendorAttendanceCreator")

  @@index([client_id])
  @@index([client_id, approval_status])
  @@map("users")
}

enum NotificationType {
  info
  alert
  appointment
  message
}

/// Central de notificacoes. Uma linha por destinatario (fan-out na escrita):
/// lido e limpeza sao por pessoa, entao compartilhar a linha exigiria uma
/// tabela de leitura so para isso.
model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  client_id   String           @db.Uuid
  user_id     String           @db.Uuid
  type        NotificationType @default(info)
  title       String           @db.VarChar(160)
  description String           @db.VarChar(500)
  /// Rota do painel aberta ao clicar. Nulo = notificacao sem destino.
  href        String?          @db.VarChar(300)
  read_at     DateTime?
  created_at  DateTime         @default(now())
  client      Client           @relation(fields: [client_id], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
  @@index([user_id, read_at])
  @@map("notifications")
}

enum UserApprovalStatus {
  pending
  approved
  rejected
}

enum VendorOperationalStatus {
  online
  away
  busy
}

enum VendorAttendanceStatus {
  pending
  accepted
  rejected
  expired
  finished
}

model VendorAvailability {
  vendor_id        String                  @id @db.Uuid
  client_id        String                  @db.Uuid
  status           VendorOperationalStatus @default(online)
  last_assigned_at DateTime?
  updated_at       DateTime                @updatedAt
  vendor           User                    @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  client           Client                  @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id, status])
  @@map("vendor_availability")
}

model VendorAttendance {
  id            String                 @id @default(uuid()) @db.Uuid
  client_id     String                 @db.Uuid
  lead_id       String                 @db.Uuid
  vendor_id     String                 @db.Uuid
  event_id      String?                @db.Uuid
  status        VendorAttendanceStatus @default(pending)
  called_at     DateTime               @default(now())
  expires_at    DateTime
  accepted_at   DateTime?
  finished_at   DateTime?
  sold          Boolean?
  created_by_id String?                @db.Uuid
  created_at    DateTime               @default(now())
  updated_at    DateTime               @updatedAt
  client        Client                 @relation(fields: [client_id], references: [id], onDelete: Cascade)
  lead          Lead                   @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  vendor        User                   @relation("VendorAttendanceVendor", fields: [vendor_id], references: [id], onDelete: Cascade)
  event         Event?                 @relation(fields: [event_id], references: [id], onDelete: SetNull)
  created_by    User?                  @relation("VendorAttendanceCreator", fields: [created_by_id], references: [id], onDelete: SetNull)

  @@index([client_id, status])
  @@index([lead_id, status])
  @@index([vendor_id, status])
  @@index([expires_at, status])
  @@map("vendor_attendances")
}

model ServiceRating {
  id                         String    @id @default(uuid()) @db.Uuid
  vendor_id                  String    @db.Uuid
  score                      Int
  event_score                Int?
  nps_score                  Int?
  comment                    String?
  customer_name              String?   @db.VarChar(255)
  event_id                   String?   @db.Uuid
  google_review_requested_at DateTime?
  google_review_clicked_at   DateTime?
  google_review_verified_at  DateTime?
  created_at                 DateTime  @default(now())
  vendor                     User      @relation(fields: [vendor_id], references: [id])
  event                      Event?    @relation(fields: [event_id], references: [id])

  @@index([vendor_id])
  @@index([event_id])
  @@index([event_id, event_score])
  @@index([event_id, nps_score])
  @@map("service_ratings")
}

model WebVitalMetric {
  id               String   @id @default(uuid()) @db.Uuid
  metric_name      String   @db.VarChar(10)
  value            Float
  rating           String   @db.VarChar(20)
  delta            Float
  metric_id        String   @db.VarChar(100)
  navigation_type  String?  @db.VarChar(50)
  path             String   @db.VarChar(500)
  session_id       String?  @db.VarChar(64)
  connection_type  String?  @db.VarChar(20)
  viewport         String?  @db.VarChar(20)
  device_memory_gb Float?
  user_agent       String?  @db.VarChar(500)
  recorded_at      DateTime
  received_at      DateTime @default(now())

  @@unique([metric_id, metric_name, path])
  @@index([metric_name, received_at(sort: Desc)])
  @@index([path, received_at(sort: Desc)])
  @@index([session_id])
  @@map("web_vital_metrics")
}

model ApiRequestMetric {
  id                   BigInt   @id @default(autoincrement())
  request_id           String   @db.VarChar(64)
  method               String   @db.VarChar(10)
  path                 String   @db.VarChar(500)
  status_code          Int
  duration_ms          Float
  database_duration_ms Float    @default(0)
  database_query_count Int      @default(0)
  slowest_query_ms     Float    @default(0)
  response_size_bytes  Int?
  is_slow              Boolean  @default(false)
  sampled_at           DateTime @default(now())

  @@index([sampled_at(sort: Desc)])
  @@index([path, sampled_at(sort: Desc)])
  @@index([is_slow, sampled_at(sort: Desc)])
  @@map("api_request_metrics")
}

model Client {
  id                          String                     @id @default(uuid()) @db.Uuid
  gestor_id                   String                     @db.Uuid
  company_name                String                     @db.VarChar(255)
  cnpj                        String?                    @db.VarChar(18)
  logo_url                    String?                    @db.VarChar(500)
  plan                        String                     @default("basic") @db.VarChar(50)
  webhook_url_n8n             String?                    @db.VarChar(500)
  facebook_page_id            String?                    @db.VarChar(100)
  facebook_access_token       String?
  whatsapp_number             String?                    @db.VarChar(20)
  phone_number                String?                    @db.VarChar(20)
  /// Token do link publico de auto-cadastro de vendedores (permanente, rotacionavel).
  vendor_signup_token         String?                    @unique @db.VarChar(64)
  settings                    Json                       @default("{}")
  created_at                  DateTime                   @default(now())
  updated_at                  DateTime                   @updatedAt
  agent_action_logs           AgentActionLog[]
  idempotency_requests        ApiIdempotencyRequest[]
  integration_credentials     IntegrationCredential[]
  appointments                Appointment[]
  campaigns                   Campaign[]
  gestor                      User                       @relation("GestorClients", fields: [gestor_id], references: [id])
  conversation_states         ConversationState[]
  conversations               Conversation[]
  dispatch_events             DispatchEvent[]
  crm_pipelines               CrmPipeline[]
  crm_stages                  CrmStage[]
  event_participations        EventParticipant[]
  events                      Event[]
  facebook_ad_accounts        FacebookAdAccount[]
  leads                       Lead[]
  meta_ad_sets                MetaAdSet[]
  meta_ads                    MetaAd[]
  meta_campaign_assignments   MetaCampaignAssignment[]
  meta_campaigns              MetaCampaign[]
  meta_connections            MetaConnection[]
  meta_creatives              MetaCreative[]
  meta_daily_insights         MetaDailyInsight[]
  meta_lead_forms             MetaLeadForm[]
  meta_lead_imports           MetaLeadImport[]
  meta_lead_routing_rules     MetaLeadRoutingRule[]
  meta_sync_jobs              MetaSyncJob[]
  rubinho_agents              RubinhoAgent[]
  sales                       Sale[]
  sales_teams                 SalesTeam[]
  score_events                ScoreEvent[]
  staff_users                 User[]                     @relation("ClientStaff")
  stores                      Store[]
  vehicles                    Vehicle[]
  webhook_events              WebhookEvent[]
  whatsapp_attribution_events WhatsAppAttributionEvent[]
  notifications               Notification[]
  vendor_availabilities       VendorAvailability[]
  vendor_attendances          VendorAttendance[]

  @@index([gestor_id])
  @@map("clients")
}

model IntegrationCredential {
  id                 String    @id @default(uuid()) @db.Uuid
  client_id          String    @db.Uuid
  allowed_client_ids String[]  @default([]) @db.Uuid
  name               String    @db.VarChar(100)
  key_prefix         String    @db.VarChar(24)
  key_hash           String    @unique @db.Char(64)
  created_at         DateTime  @default(now())
  expires_at         DateTime?
  revoked_at         DateTime?
  last_used_at       DateTime?
  client             Client    @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id, revoked_at])
  @@map("integration_credentials")
}

model Lead {
  id                          String                     @id @default(uuid()) @db.Uuid
  client_id                   String                     @db.Uuid
  name                        String                     @db.VarChar(255)
  email                       String?                    @db.VarChar(255)
  phone                       String?                    @db.VarChar(20)
  source                      LeadSource
  crm_stage_id                String?                    @db.Uuid
  tags                        String[]                   @default([])
  event_interest_id           String?                    @db.Uuid
  confirmation_status         ConfirmationStatus         @default(pending)
  confirmation_date           DateTime?
  store_visit_datetime        DateTime?
  assigned_vendor_id          String?                    @db.Uuid
  campaign_id                 String?                    @db.Uuid
  notes                       String?
  facebook_lead_id            String?                    @db.VarChar(100)
  facebook_form_id            String?                    @db.VarChar(100)
  facebook_ad_id              String?                    @db.VarChar(100)
  facebook_ad_name            String?                    @db.VarChar(255)
  facebook_ad_set_id          String?                    @db.VarChar(100)
  facebook_ad_set_name        String?                    @db.VarChar(255)
  facebook_campaign_id        String?                    @db.VarChar(100)
  facebook_campaign_name      String?                    @db.VarChar(255)
  preferred_contact_channel   String?                    @db.VarChar(50)
  source_created_at           DateTime?
  source_payload              Json?
  deleted_at                  DateTime?
  created_at                  DateTime                   @default(now())
  updated_at                  DateTime                   @updatedAt
  crm_pipeline_id             String?                    @db.Uuid
  checkin_token               String?                    @unique @db.VarChar(64)
  cpf                         String?                    @db.VarChar(20)
  wristband_number            String?                    @db.VarChar(50)
  attendant_type              AppointmentActorType?
  attendant_user_id           String?                    @db.Uuid
  sold_by_vendor_id           String?                    @db.Uuid
  team_id                     String?                    @db.Uuid
  registered_by_id            String?                    @db.Uuid
  external_ref                String?                    @db.VarChar(120)
  vehicle_plate               String?                    @db.VarChar(20)
  vehicle_brand               String?                    @db.VarChar(100)
  vehicle_model               String?                    @db.VarChar(100)
  vehicle_year                String?                    @db.VarChar(50)
  vehicle_fipe_value          String?                    @db.VarChar(50)
  companions                  String?
  description                 String?
  first_name                  String?                    @db.VarChar(100)
  last_name                   String?                    @db.VarChar(150)
  birth_date                  DateTime?                  @db.Date
  agent_action_logs           AgentActionLog[]
  appointments                Appointment[]
  conversation_states         ConversationState[]
  conversations               Conversation[]
  crm_history                 CrmHistory[]
  lead_timeline               LeadTimeline[]
  dispatch_events             DispatchEvent[]
  assigned_vendor             User?                      @relation("VendorLeads", fields: [assigned_vendor_id], references: [id])
  attendant_user              User?                      @relation("LeadAttendantUser", fields: [attendant_user_id], references: [id])
  campaign                    Campaign?                  @relation(fields: [campaign_id], references: [id])
  client                      Client                     @relation(fields: [client_id], references: [id])
  crm_pipeline                CrmPipeline?               @relation(fields: [crm_pipeline_id], references: [id])
  crm_stage                   CrmStage?                  @relation(fields: [crm_stage_id], references: [id])
  event_interest              Event?                     @relation(fields: [event_interest_id], references: [id])
  registered_by               User?                      @relation("LeadRegisteredBy", fields: [registered_by_id], references: [id])
  sold_by_vendor              User?                      @relation("LeadSoldByVendor", fields: [sold_by_vendor_id], references: [id])
  sales_team                  SalesTeam?                 @relation(fields: [team_id], references: [id])
  meta_lead_imports           MetaLeadImport[]
  sales                       Sale[]
  score_events                ScoreEvent[]
  whatsapp_attribution_events WhatsAppAttributionEvent[]
  vendor_attendances           VendorAttendance[]

  @@unique([client_id, external_ref], map: "lead_client_external_ref")
  @@index([client_id])
  @@index([team_id])
  @@index([assigned_vendor_id])
  @@index([attendant_user_id])
  @@index([sold_by_vendor_id])
  @@index([crm_pipeline_id])
  @@index([crm_stage_id])
  @@index([source])
  @@index([confirmation_status])
  @@index([store_visit_datetime])
  @@index([deleted_at])
  @@index([registered_by_id])
  @@index([campaign_id])
  @@index([event_interest_id])
  @@index([client_id, facebook_lead_id])
  @@index([client_id, facebook_campaign_id])
  @@index([client_id, deleted_at, created_at(sort: Desc)], map: "idx_leads_client_active_created")
  @@index([client_id, event_interest_id, confirmation_status], map: "idx_leads_client_event_confirmation")
  @@index([client_id, crm_pipeline_id, crm_stage_id], map: "idx_leads_client_pipeline_stage")
  @@map("leads")
}

model Event {
  id                            String                   @id @default(uuid()) @db.Uuid
  client_id                     String                   @db.Uuid
  name                          String                   @db.VarChar(255)
  description                   String?
  event_date                    DateTime
  location                      String?                  @db.VarChar(500)
  capacity                      Int?
  status                        EventStatus              @default(draft)
  cover_image_url               String?                  @db.VarChar(500)
  created_at                    DateTime                 @default(now())
  updated_at                    DateTime                 @updatedAt
  event_type                    String?                  @db.VarChar(100)
  launch_date                   DateTime?                @db.Date
  event_end_date                DateTime?
  image_urls                    String[]                 @default([])
  sales_target                  Int?
  scheduled_target              Int?
  require_wristband             Boolean                  @default(false)
  allow_vendor_checkin          Boolean                  @default(true)
  allow_vendor_fipe             Boolean                  @default(true)
  allow_vendor_create_sale      Boolean                  @default(true)
  allow_vendor_edit_sale        Boolean                  @default(false)
  allow_vendor_delete_sale      Boolean                  @default(false)
  allow_vendor_edit_own_lead    Boolean                  @default(true)
  allow_vendor_delete_own_lead  Boolean                  @default(false)
  allow_reception_create_sale   Boolean                  @default(false)
  allow_reception_edit_sale     Boolean                  @default(false)
  allow_reception_delete_sale   Boolean                  @default(false)
  allow_reception_edit_lead     Boolean                  @default(false)
  allow_reception_delete_lead   Boolean                  @default(false)
  allow_reception_quick_create  Boolean                  @default(true)
  event_days                    Json?
  total_investment              Decimal?                 @db.Decimal(12, 2)
  paid_traffic_investment       Decimal?                 @db.Decimal(12, 2)
  appointments                  Appointment[]
  dispatch_events               DispatchEvent[]
  conversation_state_last_offer ConversationState[]      @relation("ConversationStateLastOfferedEvent")
  participants                  EventParticipant[]
  client                        Client                   @relation(fields: [client_id], references: [id])
  interested_leads              Lead[]
  meta_campaign_assignments     MetaCampaignAssignment[]
  meta_lead_imports             MetaLeadImport[]
  meta_lead_routing_rules       MetaLeadRoutingRule[]
  rubinho_events                RubinhoAgentEvent[]
  sales_teams                   SalesTeam[]
  service_ratings               ServiceRating[]
  vendor_attendances            VendorAttendance[]

  @@index([client_id])
  @@index([event_date])
  @@index([status])
  @@index([client_id, status, event_date(sort: Desc)], map: "idx_events_client_status_date")
  @@map("events")
}

model EventParticipant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id   String   @db.Uuid
  client_id  String   @db.Uuid
  created_at DateTime @default(now())
  client     Client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  event      Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([event_id, client_id])
  @@index([event_id])
  @@index([client_id])
  @@map("event_participants")
}

model CrmPipeline {
  id                      String                @id @default(uuid()) @db.Uuid
  client_id               String                @db.Uuid
  code                    String                @unique @db.VarChar(40)
  name                    String                @db.VarChar(120)
  description             String?
  is_active               Boolean               @default(true)
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt
  client                  Client                @relation(fields: [client_id], references: [id])
  stages                  CrmStage[]
  leads                   Lead[]
  meta_lead_routing_rules MetaLeadRoutingRule[]

  @@index([client_id])
  @@index([is_active])
  @@map("crm_pipelines")
}

model CrmStage {
  id                               String                @id @default(uuid()) @db.Uuid
  client_id                        String                @db.Uuid
  name                             String                @db.VarChar(100)
  display_order                    Int
  color                            String                @default("#6B7280") @db.VarChar(7)
  is_final_stage                   Boolean               @default(false)
  created_at                       DateTime              @default(now())
  pipeline_id                      String                @db.Uuid
  code                             String                @unique @db.VarChar(40)
  updated_at                       DateTime              @updatedAt
  history_from                     CrmHistory[]          @relation("FromStage")
  history_to                       CrmHistory[]          @relation("ToStage")
  client                           Client                @relation(fields: [client_id], references: [id])
  pipeline                         CrmPipeline           @relation(fields: [pipeline_id], references: [id])
  leads                            Lead[]
  meta_lead_call_routing_rules     MetaLeadRoutingRule[] @relation("MetaLeadCallStage")
  meta_lead_whatsapp_routing_rules MetaLeadRoutingRule[] @relation("MetaLeadWhatsappStage")

  @@unique([pipeline_id, display_order])
  @@index([client_id])
  @@index([pipeline_id])
  @@map("crm_stages")
}

model CrmHistory {
  id                 String    @id @default(uuid()) @db.Uuid
  lead_id            String    @db.Uuid
  from_stage_id      String?   @db.Uuid
  to_stage_id        String    @db.Uuid
  changed_by_user_id String    @db.Uuid
  notes              String?
  created_at         DateTime  @default(now())
  changed_by         User      @relation(fields: [changed_by_user_id], references: [id])
  from_stage         CrmStage? @relation("FromStage", fields: [from_stage_id], references: [id])
  lead               Lead      @relation(fields: [lead_id], references: [id])
  to_stage           CrmStage  @relation("ToStage", fields: [to_stage_id], references: [id])

  @@index([lead_id])
  @@index([created_at])
  @@index([changed_by_user_id])
  @@index([from_stage_id])
  @@index([to_stage_id])
  @@map("crm_history")
}

model LeadTimeline {
  id            String                @id @default(uuid()) @db.Uuid
  client_id     String                @db.Uuid
  lead_id       String                @db.Uuid
  event_type    LeadTimelineEventType
  origin        LeadTimelineOrigin    @default(system)
  from_stage_id String?               @db.Uuid
  to_stage_id   String?               @db.Uuid
  from_value    String?               @db.VarChar(160)
  to_value      String?               @db.VarChar(160)
  actor_id      String?               @db.Uuid
  actor_label   String?               @db.VarChar(160)
  notes         String?
  metadata      Json?
  occurred_at   DateTime              @default(now())
  created_at    DateTime              @default(now())
  lead          Lead                  @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id, occurred_at])
  @@index([client_id])
  @@map("lead_timeline")
}

model Campaign {
  id                  String             @id @default(uuid()) @db.Uuid
  client_id           String             @db.Uuid
  name                String             @db.VarChar(255)
  lead_filter_rules   Json
  distribution_method DistributionMethod
  status              CampaignStatus     @default(draft)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  vendors             CampaignVendor[]
  client              Client             @relation(fields: [client_id], references: [id])
  leads               Lead[]

  @@index([client_id])
  @@index([status])
  @@map("campaigns")
}

model CampaignVendor {
  id                   String   @id @default(uuid()) @db.Uuid
  campaign_id          String   @db.Uuid
  vendor_id            String   @db.Uuid
  weight               Int      @default(1)
  max_leads            Int?
  leads_assigned_count Int      @default(0)
  campaign             Campaign @relation(fields: [campaign_id], references: [id])
  vendor               User     @relation(fields: [vendor_id], references: [id])

  @@unique([campaign_id, vendor_id])
  @@index([vendor_id])
  @@map("campaign_vendors")
}

model Conversation {
  id                       String                     @id @default(uuid()) @db.Uuid
  client_id                String                     @db.Uuid
  lead_id                  String                     @db.Uuid
  channel                  ConversationChannel
  last_message_at          DateTime?
  created_at               DateTime                   @default(now())
  agent_action_logs        AgentActionLog[]
  appointments             Appointment[]
  state                    ConversationState?
  client                   Client                     @relation(fields: [client_id], references: [id])
  lead                     Lead                       @relation(fields: [lead_id], references: [id])
  messages                 Message[]
  dispatch_events          DispatchEvent[]
  WhatsAppAttributionEvent WhatsAppAttributionEvent[]

  @@index([client_id])
  @@index([lead_id])
  @@index([last_message_at])
  @@index([client_id, last_message_at(sort: Desc)], map: "idx_conversations_client_last_message")
  @@map("conversations")
}

model Message {
