    {
      "parameters": {
        "jsCode": "const { createHash } = require(\"crypto\");\nconst query = $input.first().json.query ?? {};\n\nconst mode = query[\"hub.mode\"];\nconst token = String(query[\"hub.verify_token\"] ?? \"\");\nconst challenge = query[\"hub.challenge\"];\n\nif (mode !== \"subscribe\") {\n  return [{\n    json: {\n      statusCode: 400,\n      response: \"Modo de verificação inválido\",\n    },\n  }];\n}\n\nconst tokenHash = createHash(\"sha256\").update(token).digest(\"hex\");\nconst expectedHash = \"290c70bbbf3af1457819fae6d33df19d899a7e216990d289d485b8fba7c406f4\";\n\nif (tokenHash !== expectedHash) {\n  return [{\n    json: {\n      statusCode: 403,\n      response: \"Token de verificação inválido\",\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    statusCode: 200,\n    response: String(challenge),\n  },\n}];"
      },
