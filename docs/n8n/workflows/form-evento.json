    {
      "parameters": {
        "jsCode": "const fieldData = $json.field_data || [];\n\nconst todosOsCampos = {};\nfor (const field of fieldData) {\n  todosOsCampos[field.name] = field.values?.[0] ?? null;\n}\n\nconst normalizeKey = (value) => String(value ?? \"\")\n  .normalize(\"NFD\")\n  .replace(/[\\u0300-\\u036f]/g, \"\")\n  .replace(/:\\s*$/, \"\")\n  .trim()\n  .toLowerCase();\n\nconst getFieldValue = (...aliases) => {\n  const normalizedAliases = aliases.map(normalizeKey);\n  const exact = fieldData.find(field => normalizedAliases.includes(normalizeKey(field.name)));\n  if (exact) return exact.values?.[0] ?? null;\n  const partial = fieldData.find(field => normalizedAliases.some(alias => normalizeKey(field.name).includes(alias)));\n  return partial?.values?.[0] ?? null;\n};\n\nreturn {\n  lead_id: $json.id,\n  nome: getFieldValue(\"full_name\", \"nome_completo\"),\n  email: getFieldValue(\"email\"),\n  telefone: getFieldValue(\"phone_number\", \"telefone\"),\n  preferencia_atendimento: getFieldValue(\"prefere_ser_atendido_por\", \"gostaria_de_confirmar_sua_credencial_por\"),\n  formulario_id: $json.form_id,\n  anuncio_id: $json.ad_id,\n  anuncio: $json.ad_name,\n  campanha_id: $json.campaign_id,\n  campanha: $json.campaign_name,\n  criado_em: $json.created_time,\n  origem: \"facebook_lead_ads\",\n  todos_os_campos: todosOsCampos\n};"
      },
